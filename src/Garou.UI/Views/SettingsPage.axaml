<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Garou.ViewModels"
             x:Class="Garou.UI.Views.SettingsPage"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="*,Auto" Margin="24" RowSpacing="16">
        <TabControl Grid.Row="0">
            <TabItem Header="{Binding Settings.GeneralTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8" Margin="0,12,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Settings.LanguageLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Settings.SupportedLanguages}"
                                  SelectedItem="{Binding Settings.SelectedLanguage, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Settings.ThemeLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.ThemeOptions}"
                                  SelectedIndex="{Binding Settings.SelectedThemeIndex, Mode=TwoWay}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Settings.ApplicationsTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Settings.ApplicationPathDescription}" TextWrapping="Wrap" Opacity="0.75" />
                        <TextBlock Text="{Binding Settings.ImageMediaTypeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Settings.ImageViewerApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.ImageViewerApplicationPath, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.ImageEditorApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.ImageEditorApplicationPath, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.VideoMediaTypeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Settings.VideoViewerApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.VideoViewerApplicationPath, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.VideoEditorApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.VideoEditorApplicationPath, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.AudioMediaTypeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Settings.AudioViewerApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.AudioViewerApplicationPath, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.AudioEditorApplicationPathLabel}" />
                        <TextBox Text="{Binding Settings.AudioEditorApplicationPath, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Settings.ExtensionsLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,12,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Settings.ExtensionsLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Settings.ExtensionsDescription}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Settings.ExtensionGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExtensionPreferenceGroupViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Extensions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExtensionPreferenceViewModel">
                                                    <CheckBox Content="{Binding Extension}"
                                                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                              Margin="0,2,12,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Settings.CacheAndScanTabLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Settings.CacheLimitLabel}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="1" Maximum="1023" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding Settings.CacheLimitMegabytes, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding Settings.CacheLimitValue}" MinWidth="72"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <CheckBox Content="{Binding Settings.ScanSubfoldersLabel}"
                                  IsChecked="{Binding Settings.ScanSubfolders, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.ScanSubfoldersDescription}" TextWrapping="Wrap" Opacity="0.75" />
                        <CheckBox Content="{Binding Settings.SubfoldersLabel}"
                                  IsChecked="{Binding IncludeDescendants, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>


        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center" Margin="4">
                <TextBlock Grid.Column="0" Text="{Binding Settings.StatusText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Opacity="0.8" />
                <Button Grid.Column="1" Content="{Binding Settings.CloseLabel}" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>