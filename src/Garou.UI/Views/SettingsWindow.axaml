<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Garou.ViewModels"
        xmlns:views="using:Garou.UI.Views"
        x:Class="Garou.UI.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Settings.SettingsTitle}"
        Width="700"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <views:SettingsPage />
</Window>
